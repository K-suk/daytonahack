{
  "name": "dinner-scout",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "data:collect": "tsx scripts/dinner-data/collect.ts",
    "test:data": "tsx --test tests/data/*.test.ts && python3 -m unittest discover -s tests/data -p \"test_*.py\"",
    "dev:frontend": "next dev --hostname 127.0.0.1 --port 4312",
    "test:backend": "node scripts/test-python.mjs",
    "test:all": "npm test && npm run test:data && npm run test:backend"
  },
  "dependencies": {
    "next": "^15.5.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0",
    "dotenv": "^16.6.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.8",
    "tsx": "^4.20",
    "tailwindcss": "^4",
    "@tailwindcss/postcss": "^4",
    "@playwright/test": "^1.55"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
