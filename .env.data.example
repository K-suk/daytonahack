# Server-only. Existing .env is never overwritten. CLI may load an existing file explicitly.
# DINNER_DATA_ENV_FILE=/absolute/path/to/existing/.env
FIRECRAWL_API_KEY=
# Official development/educational test key. Replace for production use under TheMealDB terms.
THEMEALDB_API_KEY=1
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Reuse the existing backend validation virtualenv when available.
DINNER_DATA_PYTHON=python3
DINNER_DATA_RUNS_DIR=.data-runs
