# All credentials are server-only. Existing files can be loaded with DINNER_DATA_ENV_FILE.
FIRECRAWL_API_KEY=
THEMEALDB_API_KEY=1
DAYTONA_API_KEY=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Optional; use an already provisioned and verified Nosana endpoint. No automatic deployment.
NOSANA_INFERENCE_BASE_URL=
NOSANA_INFERENCE_API_KEY=
NOSANA_MODEL=
NOSANA_PROTOCOL=ollama
# Optional paths/ports. Defaults: .venv/bin/python (if present), 4312, 8787.
# DINNER_DATA_PYTHON=/absolute/path/to/python
# DINNER_DATA_ENV_FILE=/absolute/path/to/existing/.env
# PORT=4312
# DINNER_BACKEND_PORT=8787
